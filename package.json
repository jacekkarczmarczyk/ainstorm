{
  "name": "ainstorm",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:daemon": "playwright test -c playwright.daemon.config.ts",
    "daemon": "node packages/server/src/main.ts",
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @ainstorm/web run dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
